<?xml version = "1.0" encoding = "UTF-8"?>
<configuration>
    <property name="LOGS" value="D:\\Amine\\Desktop\\Intern\\StackTradeApp\\logs\\" />
    <!--  console appender -->
    <appender name = "STDOUT" class = "ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <Pattern>
                %d{ISO8601} %highlight(%-5level) [%blue(%t)] %yellow(%C{1}.%M): %msg%n%throwable
            </Pattern>
        </encoder>
    </appender>
    <!--  log file appender -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">

        <encoder>
            <Pattern>%d{ISO8601} %-5level [%t] %class{0}.%method:%L: %msg%n%throwable</Pattern>
        </encoder>
        <!-- log file directory -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- rollover daily -->
            <fileNamePattern>${LOGS}stack-trade-app-log-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <!-- each file should be at most 100MB, keep 60 days worth of history, but at most 20GB -->
            <maxFileSize>100MB</maxFileSize>
            <!-- keep 60 days worth of history -->
            <maxHistory>60</maxHistory>
            <!-- or whenever the file size reaches 20GB -->
            <totalSizeCap>20GB</totalSizeCap>
        </rollingPolicy>

    </appender>
    <!--  root logger -->
    <root level = "INFO">
        <appender-ref ref = "FILE"/>
        <appender-ref ref = "STDOUT"/>
    </root>
</configuration>